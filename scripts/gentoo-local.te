module gentoo-local 1.15;

require {
    type NetworkManager_t; type default_t; type init_t; type init_exec_t; type unconfined_t;
    type lvm_t; type lvm_runtime_t; type initrc_lock_t; type initrc_t; type devicekit_disk_t;
    type chkpwd_t; type sysctl_kernel_t; type fail2ban_client_t;
    type gpg_agent_t; type user_tmp_t; type xdg_data_t; type iceauth_t;
    type java_t; type bin_t; type lib_t; type cgroup_t;
    type mplayer_t; type session_dbusd_runtime_t; type sysctl_vm_overcommit_t;
    type var_lib_t; type xserver_tmpfs_t; type user_runtime_t;
    type policykit_t; type systemd_transient_unit_t;
    type portage_t; type portage_devpts_t; type etc_t; type proc_t; type systemd_hwdb_t;
    type semanage_exec_t; type semanage_t; type load_policy_t; type setfiles_t;
    type systemd_tmpfiles_t; type syslogd_runtime_t; type unlabeled_t;
    type fusefs_t; type init_runtime_t; type udevadm_t; type udev_t; type wireshark_t;
    type kernel_t; type systemd_logind_t; type dosfs_t; type fixed_disk_device_t;
    type debugfs_t; type device_t; type devpts_t; type fs_t; type hugetlbfs_t;
    type sysfs_t; type tmpfs_t; type tracefs_t; type semanage_store_t;
    type gkeyringd_exec_t; type systemd_user_runtime_dir_t; type usr_t;

    class filesystem getattr;
    class process { getsched noatsecure rlimitinh setrlimit siginh signull transition };
    class capability2 mac_admin;
    class file { create entrypoint execute_no_trans getattr lock map open read relabelfrom relabelto unlink write };
    class dir { add_name getattr lock open read remove_name search watch write };
    class sock_file { create getattr setattr unlink write };
    class lnk_file { getattr read unlink };
    class chr_file { read write };
    class blk_file { getattr ioctl open read };
    class sem { associate read unix_read unix_write write };
    class system module_request;
    class service status;
}

# =============================================================================
# CRITICAL — systemd user session startup
# init_t (systemd PID 1) must transition to unconfined_t to start the desktop
# session. Blocking this causes SDDM to drop back to login screen.
# =============================================================================
allow init_t unconfined_t:process transition;
allow unconfined_t init_exec_t:file entrypoint;
allow unconfined_t usr_t:file entrypoint;
allow unconfined_t gkeyringd_exec_t:file entrypoint;

# --- NetworkManager ---
allow NetworkManager_t default_t:dir search;
allow NetworkManager_t unconfined_t:process signull;

# --- capability2 mac_admin (SELinux label manipulation at boot/session setup) ---
allow init_t self:capability2 mac_admin;
allow udev_t self:capability2 mac_admin;
allow systemd_logind_t self:capability2 mac_admin;

# --- devicekit (udisks) ---
allow devicekit_disk_t lvm_runtime_t:dir { add_name remove_name write };
allow devicekit_disk_t lvm_runtime_t:file { create lock open read unlink write };

# --- chkpwd_t (PAM password authentication helper) ---
allow chkpwd_t sysctl_kernel_t:dir search;
allow chkpwd_t sysctl_kernel_t:file { open read };

# --- fail2ban ---
allow fail2ban_client_t self:process getsched;

# --- GPG agent ---
allow gpg_agent_t user_tmp_t:dir { add_name remove_name getattr read search watch write };
allow gpg_agent_t user_tmp_t:sock_file { create setattr unlink };
allow gpg_agent_t xdg_data_t:file { getattr write };

# --- ICEauth (X11 session auth) ---
allow iceauth_t xdg_data_t:file write;

# --- java_t ---
allow java_t bin_t:dir read;
allow java_t cgroup_t:dir search;
allow java_t cgroup_t:file { getattr open read };
allow java_t lib_t:file execute_no_trans;

# --- LVM ---
allow lvm_t initrc_lock_t:file write;
allow lvm_t initrc_t:sem { associate read unix_read unix_write write };

# --- mplayer_t (VLC) ---
allow mplayer_t self:process setrlimit;
allow mplayer_t session_dbusd_runtime_t:sock_file write;
allow mplayer_t sysctl_vm_overcommit_t:file { open read };
allow mplayer_t user_runtime_t:sock_file write;
allow mplayer_t var_lib_t:file map;
allow mplayer_t xserver_tmpfs_t:file map;

# --- policykit_t ---
allow policykit_t systemd_transient_unit_t:service status;

# --- portage_t ---
allow portage_t etc_t:file relabelfrom;
allow portage_t proc_t:filesystem getattr;
allow portage_t systemd_hwdb_t:file relabelto;

# --- semanage_t (policy store access; root is unconfined_t which execs semanage_t) ---
allow semanage_t self:process getsched;
allow semanage_t cgroup_t:filesystem getattr;
allow semanage_t debugfs_t:filesystem getattr;
allow semanage_t device_t:filesystem getattr;
allow semanage_t devpts_t:filesystem getattr;
allow semanage_t fs_t:filesystem getattr;
allow semanage_t hugetlbfs_t:filesystem getattr;
allow semanage_t proc_t:filesystem getattr;
allow semanage_t sysfs_t:filesystem getattr;
allow semanage_t tmpfs_t:filesystem getattr;
allow semanage_t tracefs_t:filesystem getattr;
allow semanage_t semanage_store_t:dir { add_name getattr open read remove_name search write };
allow semanage_t semanage_store_t:file { create getattr open read unlink write };

# --- systemd_logind_t (EFI/UEFI boot entry management, disk access) ---
allow systemd_logind_t dosfs_t:dir { getattr open read search };
allow systemd_logind_t fixed_disk_device_t:blk_file { getattr ioctl open read };

# --- systemd_tmpfiles_t ---
allow systemd_tmpfiles_t bin_t:dir search;
allow systemd_tmpfiles_t bin_t:lnk_file { getattr read };
allow systemd_tmpfiles_t default_t:dir search;
allow systemd_tmpfiles_t fusefs_t:dir getattr;
allow systemd_tmpfiles_t init_runtime_t:sock_file getattr;
allow systemd_tmpfiles_t syslogd_runtime_t:sock_file getattr;
allow systemd_tmpfiles_t unlabeled_t:dir { getattr lock open read search };
allow systemd_tmpfiles_t unlabeled_t:file getattr;
allow systemd_tmpfiles_t user_tmp_t:lnk_file getattr;

# --- systemd_user_runtime_dir_t ---
allow systemd_user_runtime_dir_t user_tmp_t:lnk_file unlink;

# --- udevadm_t ---
allow udevadm_t portage_devpts_t:chr_file { read write };

# --- wireshark_t ---
allow wireshark_t kernel_t:system module_request;
allow wireshark_t session_dbusd_runtime_t:sock_file write;
allow wireshark_t xserver_tmpfs_t:file map;
